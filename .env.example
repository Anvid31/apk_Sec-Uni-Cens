# Configuración de correo electrónico - ARCHIVO DE EJEMPLO
# Copie este archivo como .env y configure sus credenciales reales
# El archivo .env NO debe subirse a control de versiones

# Correo destino donde se enviarán las caracterizaciones
DESTINATION_EMAIL=tu_correo_destino@gmail.com

# Cuenta emisora (Gmail recomendado)
SENDER_EMAIL=tu_cuenta_gmail@gmail.com

# Contraseña de aplicación de Gmail (NO la contraseña normal)
# Para generar: https://myaccount.google.com/security > Contraseñas de aplicaciones
SENDER_PASSWORD=tu_contraseña_de_aplicacion_16_caracteres

# Configuración SMTP (normalmente no necesita cambiar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Nombre del remitente
SENDER_NAME=CaracT Móvil

MONGO_CONN_URL=mongodb://usuario:contraseña@host:puerto/base_de_datos

# ── PostgreSQL (reemplaza MongoDB) ────────────────────────────────────────────
PG_HOST=192.168.1.100
PG_PORT=5432
PG_DB=caracterizacion_cens
PG_USER=caract_user
PG_PASSWORD=cambia_esta_clave
# ─────────────────────────────────────────────────────────────────────────────

# ── Actualización automática vía GitHub Releases ──────────────────────────────
# Organización o usuario propietario del repositorio
GITHUB_OWNER=tu-organizacion
# Nombre del repositorio (sin URL)
GITHUB_REPO=caract-movil
# ───────────────────────────────
