# Configuración de la aplicación — ARCHIVO DE EJEMPLO
# Copie este archivo como .env y configure sus credenciales reales.
# El archivo .env NO debe subirse a control de versiones.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=192.168.1.100
PG_PORT=5432
PG_DB=caracterizacion_cens
PG_USER=caract_user
PG_PASSWORD=cambia_esta_clave

# ── Actualización automática vía GitHub Releases ──────────────────────────────
GITHUB_OWNER=tu-organizacion
GITHUB_REPO=caract-movil
